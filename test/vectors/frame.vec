# PUSHM saves from the highest register down (lowest register at the lowest address);
# RTSD #imm,Rd-Rd2: imm*4 = locals + saved registers, PC popped last
pushm_order | 6e 13    | SP=0x3000 R1=0x11 R2=0x22 R3=0x33 | PUSHM R1-R3 | SP=0x2FF4 mem32[0x2FF4]=0x11 mem32[0x2FF8]=0x22 mem32[0x2FFC]=0x33
popm_order  | 6f 13    | SP=0x2FF4 mem32[0x2FF4]=0x11 mem32[0x2FF8]=0x22 mem32[0x2FFC]=0x33 | POPM R1-R3 | SP=0x3000 R1=0x11 R2=0x22 R3=0x33
rtsd_pop    | 3f 13 03 | SP=0x2FF4 mem32[0x2FF4]=0x11 mem32[0x2FF8]=0x22 mem32[0x2FFC]=0x33 mem32[0x3000]=0x1234 | - | R1=0x11 R2=0x22 R3=0x33 SP=0x3004 PC=0x1234
rtsd_locals | 3f 13 05 | SP=0x2FEC mem32[0x2FF4]=0x11 mem32[0x2FF8]=0x22 mem32[0x2FFC]=0x33 mem32[0x3000]=0x1234 | - | R1=0x11 R2=0x22 R3=0x33 SP=0x3004 PC=0x1234
